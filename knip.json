{
  "$schema": "https://unpkg.com/knip/schema.json",
  "eslint": {
    "config": []
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.{ts,js,mjs,cjs}",
        "*.config.{ts,js,mjs,cjs}"
      ],
      "project": [
        "tools/**/*.{ts,js,mjs,cjs}"
      ]
    },
    "apps/quartz": {
      "entry": [
        "src/app/**/{page,layout,template,default,route,error,loading,not-found}.{ts,tsx,js,jsx}",
        "next.config.{js,mjs,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx}"
      ]
    },
    "apps/*": {
      "entry": [
        "src/main.{ts,tsx,js,jsx}",
        "src/index.{ts,tsx,js,jsx}",
        "src/app/**/*.{ts,tsx,js,jsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx}"
      ],
      "ignoreDependencies": [
        "@wuguishifu/*"
      ]
    },
    "libs/*": {
      "entry": [
        "src/index.{ts,tsx,js,jsx}",
        "src/{lib,app}/**/*.{ts,tsx,js,jsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,js,jsx}"
      ]
    }
  },
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css"
  ]
}
