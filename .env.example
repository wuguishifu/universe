# set this to development | staging | production to point to the correct environment
ENVIRONMENT=development

# Override database connection (e.g. when running osmium in Docker, use postgres service hostname)
# HYDROGEN_DB_URL=postgresql://user:password@postgres:5432/hydrogen

# Set to false when connecting to PostgreSQL servers that don't support SSL (e.g. via Tailscale)
# HYDROGEN_DB_SSL=false
