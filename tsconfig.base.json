{
  "compileOnSave": false,
  "compilerOptions": {
    "esModuleInterop": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "noUnusedLocals": false,
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "@wuguishifu/environment": ["libs/environment/src/index.ts"],
      "@wuguishifu/engine": ["libs/engine/src/index.ts"],
      "@wuguishifu/nest-common": ["libs/nest-common/src/index.ts"],
      "@wuguishifu/ui-web": ["libs/ui-web/src/index.ts"],
      "@wuguishifu/utils-web": ["libs/utils-web/src/index.ts"],
    },
    // this is required while https://github.com/nrwl/nx/issues/32398 is not resolved
    "types": ["node"],
  },
  "exclude": ["node_modules"],
}
