{
  "compileOnSave": false,
  "compilerOptions": {
    "esModuleInterop": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "noUnusedLocals": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "@wuguishifu/environment": ["libs/environment/src/index.ts"],
      "@wuguishifu/ui-web": ["libs/ui-web/src/index.ts"],
      "@wuguishifu/utils-web": ["libs/utils-web/src/index.ts"],
    }
  },
  "exclude": ["node_modules"]
}
