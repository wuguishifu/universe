# Locally, secrets come from Infisical dev /ruby via `nx setup environment` (written to .env.local,
# along with hydrogen's CONVEX_URL). Values below are what the app reads.

DISCORD_TOKEN=
# Comma-separated guild IDs: slash commands register there instantly. Leave empty in production.
DISCORD_DEV_GUILD_IDS=

REDIS_URL=redis://localhost:6379

# hydrogen deployment; RUBY_CONVEX_SECRET must match the env var of the same name set there
# (pnpm nx convex hydrogen -- env set RUBY_CONVEX_SECRET <value>).
CONVEX_URL=
RUBY_CONVEX_SECRET=

# tungsten, the speech-to-text service (runs on the Mac mini)
TUNGSTEN_URL=http://bos-mac-mini:3002
TUNGSTEN_API_TOKEN=

# UTTERANCE_SILENCE_MS=1000
# UTTERANCE_MIN_MS=500
# UTTERANCE_MAX_MS=30000
# PORT=3003
