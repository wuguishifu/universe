{
  "name": "osmium",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/osmium/src",
  "projectType": "application",
  "tags": ["scope:server"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": ["nx setup environment"]
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["setup"],
      "options": {
        "assets": [],
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/osmium",
        "main": "apps/osmium/src/main.ts",
        "tsConfig": "apps/osmium/tsconfig.app.json",
        "isolatedConfig": true,
        "webpackConfig": "apps/osmium/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "osmium:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "osmium:build:development"
        },
        "production": {
          "buildTarget": "osmium:build:production"
        }
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/osmium",
        "command": "tsc -p tsconfig.app.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/osmium/**/*.ts"],
        "maxWarnings": 0
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/osmium/**/*.ts"],
        "maxWarnings": 0,
        "fix": true
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc", "lint"],
      "options": {
        "command": "echo Prepush Done!"
      }
    }
  }
}
