{
  "name": "hydrogen",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hydrogen",
  "projectType": "application",
  "tags": ["scope:server", "build-on-install"],
  "// targets": "to see all targets run: nx show project hydrogen --web",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/hydrogen",
        "parallel": true,
        "commands": [
          "rm -rf ./dist",
          "rm -rf ./node_modules",
          "rm -rf ./out-tsc"
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": ["nx tsc hydrogen --skip-sync", "nx build hydrogen-kore"]
      }
    },
    "build:kore": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": ["nx build hydrogen", "nx build hydrogen-kore"]
      }
    },
    "convex": {
      "executor": "nx:run-commands",
      "//note": "Example for how to forward commands to the convex CLI: nx convex hydrogen -- dev --help",
      "options": {
        "cwd": "apps/hydrogen",
        "forwardAllArgs": true,
        "command": "convex"
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/hydrogen",
        "parallel": false,
        "commands": [
          "convex dev --once",
          "ts-node ../../scripts/convex/copy-local-env.mts"
        ]
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "parallel": true,
        "commands": [
          {
            "command": "nx convex hydrogen -- dev",
            "description": "Run Convex dev watcher",
            "prefix": "hydrogen",
            "prefixColor": "cyan"
          },
          {
            "command": "nx run hydrogen:watch-kore",
            "description": "Rebuild hydrogen-kore on change",
            "prefix": "kore",
            "prefixColor": "magenta"
          }
        ]
      }
    },
    "watch-kore": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "nx watch --projects=hydrogen --initialRun -- nx build hydrogen-kore"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/hydrogen",
        "command": "convex deploy"
      }
    },
    "preview-urls": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/convex/get-preview-urls.sh {args.previewName}"
      }
    },
    "update:ai-files": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/hydrogen",
        "command": "npx convex ai-files update"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build tsconfig.json",
        "cwd": "apps/hydrogen"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    },
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun madge . --circular --extensions js,ts,tsx --warning --exclude '(^|/)convex/_generated(/|$)'",
        "cwd": "apps/hydrogen"
      }
    }
  }
}
