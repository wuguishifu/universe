{
  "name": "quartz",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/quartz",
  "projectType": "application",
  "tags": ["scope:hybrid"],
  "// targets": "to see all targets run: nx show project quartz --web",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf apps/quartz/.next"
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["clean"],
      "options": {
        "outputPath": "apps/quartz"
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx setup environment"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --targets=slicemachine,serve --projects=quartz"
      }
    },
    "slicemachine": {
      "executor": "nx:run-commands",
      "options": {
        "command": "start-slicemachine",
        "cwd": "apps/quartz"
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "quartz:build",
        "dev": true,
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "quartz:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "quartz:build:production",
          "dev": false
        }
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build tsconfig.json",
        "cwd": "apps/quartz"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    },
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm madge . --circular --extensions js,ts,tsx --warning --exclude '(^|/)convex/_generated(/|$)'",
        "cwd": "apps/quartz"
      }
    }
  }
}
