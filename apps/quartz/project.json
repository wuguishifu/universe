{
  "name": "quartz",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/quartz",
  "projectType": "application",
  "tags": ["scope:hybrid"],
  "// targets": "to see all targets run: nx show project quartz --web",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf apps/quartz/.next"
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["clean"],
      "options": {
        "outputPath": "apps/quartz"
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --targets=slicemachine,serve --projects=quartz"
      }
    },
    "slicemachine": {
      "executor": "nx:run-commands",
      "options": {
        "command": "start-slicemachine",
        "cwd": "apps/quartz"
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "quartz:build",
        "dev": true,
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "quartz:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "quartz:build:production",
          "dev": false
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        {
          "fileset": "{projectRoot}/**/*.d.ts",
          "dependencies": true
        },
        {
          "externalDependencies": ["next", "typescript"]
        }
      ],
      "outputs": [
        "{projectRoot}/.next/types/**/*.ts",
        "{projectRoot}/dist/tsconfig.tsbuildinfo"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "cwd": "apps/quartz",
        "command": "next typegen && tsc --project tsconfig.json --noEmit"
      }
    },
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm madge . --circular --extensions js,ts,tsx --warning --exclude '(^|/)convex/_generated(/|$)'",
        "cwd": "apps/quartz"
      }
    }
  }
}
