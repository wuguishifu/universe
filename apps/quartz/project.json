{
  "name": "quartz",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/quartz",
  "projectType": "application",
  "tags": ["scope:hybrid"],
  "// targets": "to see all targets run: nx show project quartz --web",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf apps/quartz/.next"
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["clean"],
      "options": {
        "outputPath": "apps/quartz"
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx setup environment"
      }
    },
    "setup:post": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx setup:post environment"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --targets=slicemachine,serve --projects=quartz"
      }
    },
    "slicemachine": {
      "executor": "nx:run-commands",
      "options": {
        "command": "start-slicemachine",
        "cwd": "apps/quartz"
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "quartz:build",
        "dev": true,
        "port": 3000
      },
      "configurations": {
        "development": {
          "buildTarget": "quartz:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "quartz:build:production",
          "dev": false
        }
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "apps/quartz"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "maxWarnings": 0,
        "fix": true
      }
    },
    "ci:checks": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc", "lint"],
      "options": {
        "command": "echo CI checks done!"
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["ci:checks"],
      "options": {
        "command": "echo Prepush done!"
      }
    }
  }
}
