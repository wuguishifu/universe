# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local, along with convex's CONVEX_URL). Values below are what the app reads.

# Bearer token for POST /api/notifications (callers using the client's http transport send it as
# NOTIFICATIONS_SERVICE_API_TOKEN).
API_TOKEN=

REDIS_URL=redis://localhost:6379

# convex deployment; NOTIFICATIONS_CONVEX_SECRET must match the env var of the same name set there
# (pnpm nx convex convex-app -- env set NOTIFICATIONS_CONVEX_SECRET <value>).
CONVEX_URL=
NOTIFICATIONS_CONVEX_SECRET=

# An Expo access token, required since the project has enhanced push security turned on (expo.dev).
EXPO_ACCESS_TOKEN=

# PORT=3011
