# Locally, these come from `nx setup environment` (written to .env.local): EXPO_PUBLIC_CONVEX_URL from convex, the
# device secret from Infisical dev (see secretsPaths in environment-config.json). EAS builds read them from the EAS
# environment their profile names instead (eas env:create), so they're never committed.
#
# Anything EXPO_PUBLIC_ is inlined into the app bundle, so it isn't secret from whoever has the app.

EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
# Must match NOTIFICATIONS_DEVICE_SECRET on the convex deployment
# (pnpm nx convex convex-app -- env set NOTIFICATIONS_DEVICE_SECRET <value>).
EXPO_PUBLIC_NOTIFICATIONS_DEVICE_SECRET=
