# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local). Values below are what the app reads.

# Where clients reach the service. It's the OAuth issuer, and Authelia's `mcp` client has
# http://localhost:3012/oauth/callback registered for local runs.
PUBLIC_URL=http://localhost:3012

REDIS_URL=redis://localhost:6379

# The `mcp` OIDC client's secret (its digest is MCP_CLIENT_SECRET_DIGEST in Authelia's secrets).
# Signing in goes through the real Authelia, so run this on the tailnet.
AUTHELIA_CLIENT_SECRET=
# AUTHELIA_URL=https://auth.wuguishifu.dev
# AUTHELIA_CLIENT_ID=mcp

# Comma-separated. Loopback redirect URIs (http://localhost:<port>/...) are always allowed.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Hostnames a browser may call /mcp from.
# ALLOWED_ORIGINS=claude.ai,claude.com,localhost

# ACCESS_TOKEN_TTL_MINUTES=60
# REFRESH_TOKEN_TTL_DAYS=30

# The apps with tools. Locally, thermo-automation-service from `nx serve`.
THERMO_AUTOMATION_SERVICE_URL=http://localhost:3009
# mega-client-service from `nx serve` (or the NAS's, over the tailnet).
MEGA_CLIENT_SERVICE_URL=http://localhost:3010

# PORT=3012
