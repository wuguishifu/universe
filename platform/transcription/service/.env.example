# api | worker | all. Production runs `api` and `worker` as separate Deployments.
ROLE=all
# Lanes this process works on when it's a worker: interactive, batch, or both.
WORKER_LANES=interactive,batch
PORT=3002

# Callers send `Authorization: Bearer <token>`. At least 16 characters.
API_TOKEN=
REDIS_URL=redis://localhost:6379

# Worker only. Directory of ggml-<model>.bin files; WHISPER_MODELS lists the ones callers may use.
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODELS_DIR=
WHISPER_MODELS=base.en
# WHISPER_DEFAULT_MODEL=base.en
# WHISPER_VAD_MODEL_PATH=
# WHISPER_THREADS_INTERACTIVE=4
# WHISPER_THREADS_BATCH=4
# WHISPER_BEAM_SIZE_INTERACTIVE=1   # 1 = greedy (fast); whisper-cli's default is 5
# WHISPER_BEAM_SIZE_BATCH=5
# FFMPEG_PATH=ffmpeg

# Optional: only needed to accept { type: 's3' } audio sources.
# S3_ENDPOINT=https://s3.wuguishifu.dev
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
