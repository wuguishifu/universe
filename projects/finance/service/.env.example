# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local, along with convex's CONVEX_URL and CONVEX_SITE_URL). Values below are what the app reads.

# projects/finance/common (shared with finance-sandbox)
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
# sandbox | production; the secret decides which one works
PLAID_ENV=sandbox

# projects/finance/service. 32 random bytes, base64: `openssl rand -base64 32`. Encrypts Plaid access
# tokens before they're stored in convex. Changing it makes every stored token unreadable.
PLAID_TOKEN_KEY=

# convex deployment; FINANCE_CONVEX_SECRET must match the env var of the same name set there
# (pnpm nx convex convex-app -- env set FINANCE_CONVEX_SECRET <value>).
CONVEX_URL=
# Convex Auth's JWT issuer, for checking the tokens finance-web sends.
CONVEX_SITE_URL=
FINANCE_CONVEX_SECRET=

# PORT=3013
