{
  "expo": {
    "name": "Sapphire",
    "slug": "sapphire-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sapphire",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/86a068db-c3ea-45da-aaa6-afe1b05aecae"
    },
    "ios": {
      "bundleIdentifier": "dev.wuguishifu.sapphire",
      "supportsTablet": false,
      "appleTeamId": "7C3LJCLXTY",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        },
        "NSFaceIDUsageDescription": "Face ID unlocks your vault and saved SSH logins.",
        "SapphireVaultAppGroup": "group.dev.wuguishifu.sapphire",
        "SapphireVaultSharedKeychainGroup": "$(AppIdentifierPrefix)dev.wuguishifu.sapphire.shared",
        "SapphireVaultAppKeychainGroup": "$(AppIdentifierPrefix)dev.wuguishifu.sapphire"
      },
      "entitlements": {
        "com.apple.developer.authentication-services.autofill-credential-provider": true,
        "com.apple.security.application-groups": [
          "group.dev.wuguishifu.sapphire"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)dev.wuguishifu.sapphire",
          "$(AppIdentifierPrefix)dev.wuguishifu.sapphire.shared"
        ]
      }
    },
    "android": {
      "package": "dev.wuguishifu.sapphire",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0b121b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@bacons/apple-targets",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0b121b"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86a068db-c3ea-45da-aaa6-afe1b05aecae"
      }
    },
    "owner": "wuguishifu"
  }
}
