# Locally, secrets come from Infisical (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local, along with convex's NEXT_PUBLIC_CONVEX_URL). On Vercel, set them on the project.

# Bearer token for POST /api/notifications (the sapphire-mobile EAS workflow sends it as
# SAPPHIRE_WEB_API_TOKEN).
API_TOKEN=

# notifications-service, from Infisical's platform/notifications/client. On Vercel, the URL is the
# Cloudflare tunnel's hostname.
NOTIFICATIONS_SERVICE_URL=
NOTIFICATIONS_SERVICE_API_TOKEN=

# Cloudflare Access service token for the tunnel. Leave both unset to call the service directly
# (e.g. locally, over the tailnet).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
