# Locally, secrets come from Infisical dev /projects/jankbot/gateway via `nx setup environment` (written to .env.local).
# Values below are what the app reads.

# This gateway's bot. Every gateway needs its own bot (a bot can only be in one voice channel per
# server), and only one gateway may run per token.
DISCORD_TOKEN=

# primary: the bot that owns the slash commands (the same bot as jankbot-core's DISCORD_TOKEN). It
# forwards every command to core. Run exactly one. worker: only joins and leaves when core says so.
# Every gateway, primary included, is a voice bot.
ROLE=primary
# This voice bot's name, as listed in jankbot-core's VOICE_BOTS (case doesn't matter). Unique per gateway.
NAME=Bo

# Must be the same Redis as jankbot-core: the queues and the remembered voice sessions live here.
REDIS_URL=redis://localhost:6379

# UTTERANCE_SILENCE_MS=1000
# UTTERANCE_MIN_MS=500
# UTTERANCE_MAX_MS=30000
# VOICE_IDLE_TIMEOUT_MS=300000
# PORT=3004
