# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local). Values below are what the app reads.

# Must be the same Redis as jankbot-gateway and jankbot-core: stitch jobs come from the gateway, and the stitcher
# reads core's queues to tell when a session's utterances are all transcribed.
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# The bucket core uploads utterances to; compilations go under compilations/ in it.
RECORDINGS_S3_BUCKET=

UNIVERSE_DB_CONNECTION_STRING=

ANALYTICS_SERVICE_BASE_URL=
ANALYTICS_SERVICE_API_TOKEN=

# In the container, where the host's ffmpeg is mounted (it isn't in the image). Must have libopus; checked on startup.
# FFMPEG_PATH=ffmpeg
# How long after a session ends to wait for its utterances to be transcribed before stitching what's there.
# STITCH_MAX_WAIT_MS=3600000

# PORT=3007
