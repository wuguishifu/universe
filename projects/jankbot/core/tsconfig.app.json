{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "references": [
    {
      "path": "../../../libs/redis-cache/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/queue/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/phrase-matching/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/nest/s3/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/nest/redis-cache/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/nest/universe-db/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/nest-common/tsconfig.lib.json"
    },
    {
      "path": "../../../platform/postgres/db/tsconfig.lib.json"
    },
    {
      "path": "../../../platform/transcription/client-nest/tsconfig.lib.json"
    },
    {
      "path": "../../../platform/analytics/client-nest/tsconfig.lib.json"
    },
    {
      "path": "../../../platform/convex/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../../platform/transcription/contracts/tsconfig.lib.json"
    },
    {
      "path": "../contracts/tsconfig.lib.json"
    }
  ]
}
