# Locally, secrets come from Infisical dev /projects/jankbot/ruby (still under its old name; see infisicalPath in
# platform/environment/config.json) via `nx setup environment` (written to .env.local,
# along with convex's CONVEX_URL). Values below are what the app reads.

# Only used for Discord's HTTP API (command registration, interaction replies).
DISCORD_TOKEN=
# Comma-separated guild IDs: slash commands register there instantly. Leave empty in production.
DISCORD_DEV_GUILD_IDS=

# The voice bots, one per gateway (each gateway's NAME). /join sends the first free one in this order.
VOICE_BOTS=Bo

REDIS_URL=redis://localhost:6379

# convex deployment; RUBY_CONVEX_SECRET must match the env var of the same name set there
# (pnpm nx convex convex-app -- env set RUBY_CONVEX_SECRET <value>).
CONVEX_URL=
RUBY_CONVEX_SECRET=

# transcription-service, the speech-to-text service (runs on the Mac mini)
TRANSCRIPTION_SERVICE_URL=http://bos-mac-mini:3002
TRANSCRIPTION_SERVICE_API_TOKEN=

# PORT=3003
