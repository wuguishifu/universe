# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via
# `nx setup environment` (written to .env.local). Values below are what the app reads.

# The NAS's Traefik API, over the tailnet (`api.insecure`, or a router to api@internal).
TRAEFIK_API_URL=http://truenas:8080
# Set both if the API is behind basic auth.
# TRAEFIK_API_USERNAME=
# TRAEFIK_API_PASSWORD=

# DOMAIN=wuguishifu.dev
# Where tailnet hosts point: the NAS's Tailscale IP (A record), or a hostname (CNAME).
TAILNET_TARGET=100.64.0.10
# Hosts whose first label ends with GATEWAY_SUFFIX are public: a proxied CNAME to the NAS's
# Cloudflare Tunnel. Unset GATEWAY_TARGET skips them.
# GATEWAY_SUFFIX=-gw
# GATEWAY_TARGET=<tunnel-id>.cfargotunnel.com

# SYNC_INTERVAL_SECONDS=60
# How long a host can be missing from Traefik before its record is removed.
# REMOVAL_GRACE_SECONDS=300

# The DNSEndpoint external-dns reads.
# DNS_ENDPOINT_NAMESPACE=external-dns
# DNS_ENDPOINT_NAME=nas-routes

# Locally: log what would be applied instead of touching the cluster.
DRY_RUN=true
# Or run `kubectl proxy` and point this at it to apply for real. Unset in a pod.
# KUBE_API_URL=http://127.0.0.1:8001

# PORT=3012
