# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via
# `nx setup environment` (written to .env.local). Values below are what the app reads.

ANALYTICS_SERVICE_BASE_URL=
ANALYTICS_SERVICE_API_TOKEN=

# Holds open outage incidents so a restart mid-outage still records the end event.
REDIS_URL=redis://localhost:6379

# The home router's LAN address. Not auto-detected: inside a pod the default route points at the
# CNI bridge, not the router. A refused connection counts as up, so any port the router answers on works.
GATEWAY_HOST=10.21.164.1
# GATEWAY_PORT=80

# PORT=3006
