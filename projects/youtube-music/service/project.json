{
  "name": "youtube-music-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/youtube-music/service/src",
  "projectType": "application",
  "tags": ["scope:server"],
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "youtube-music-service:build"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test 'src/**/*.spec.ts'",
        "cwd": "projects/youtube-music/service"
      }
    },
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm madge . --circular --extensions js,ts,tsx --warning",
        "cwd": "projects/youtube-music/service"
      }
    }
  }
}
