# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local). Values below are what the app reads.

# Bearer token for the API, which the app is set up with (at least 16 characters).
API_TOKEN=

REDIS_URL=redis://localhost:6379
UNIVERSE_DB_CONNECTION_STRING=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Where tracks are uploaded, at tracks/<youtube id>/{audio.m4a,artwork.jpg}.
# MUSIC_S3_BUCKET=youtube-music

# In the container, where the host's binaries are mounted (they aren't in the image). Checked on startup.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Extra args for every yt-dlp call, e.g. cookies if YouTube starts asking to confirm you're not a bot.
# YTDLP_EXTRA_ARGS=--cookies /data/cookies.txt

# Longer videos fail instead of downloading.
# MAX_DURATION_MINUTES=180
# DOWNLOAD_CONCURRENCY=2

# PORT=3010
