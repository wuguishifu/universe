{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "identifier": "com.wuguishifu.clipper",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:4212",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../../../../dist/projects/clipper/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
