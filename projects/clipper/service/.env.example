# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via `nx setup environment`
# (written to .env.local, along with convex's CONVEX_URL). Values below are what the app reads.

# Bearer token for the API (the Windows client and tools/scripts/media/submit-backlog.mjs).
API_TOKEN=

GEMINI_API_KEY=
# Once today's (UTC) Gemini spend reaches this, clips wait until tomorrow.
# CLIPPER_DAILY_SPEND_LIMIT_USD=25

# convex deployment; CLIPPER_CONVEX_SECRET must match the env var of the same name set there
# (pnpm nx convex convex-app -- env set CLIPPER_CONVEX_SECRET <value>).
CONVEX_URL=
CLIPPER_CONVEX_SECRET=

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Where clips' proxies are uploaded, at proxies/<sha256>.mp4.
# CLIPPER_S3_BUCKET=clipper

ANALYTICS_SERVICE_BASE_URL=
ANALYTICS_SERVICE_API_TOKEN=

# In the container, where the host's ffmpeg is mounted (it isn't in the image). Must have libx264 and aac; checked on
# startup. Used to cut out the audio, or the tail of a clip, before sending it to Gemini.
# FFMPEG_PATH=ffmpeg

# PORT=3008
