# Copy to .env for local development. Nothing here is secret, so there's no Infisical path.

# Where downloads land. Must be absolute.
DOWNLOAD_PATH=/Users/$USER/Downloads

# MEGAcmd's CLI. Defaults to `mega-exec` on the PATH (as in the image); on macOS it's in the app bundle.
# MEGA_EXEC=/Applications/MEGAcmd.app/Contents/MacOS/mega-exec

# Where the built SPA (mega-client-web) is served from. Unset in development, where the Vite dev server serves
# it and proxies /api here. The Docker image sets it.
# WEB_ROOT=

# PORT=3010
