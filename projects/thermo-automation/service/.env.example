# Locally, secrets come from Infisical dev /projects/thermo-automation/service (see secretsPaths in environment-config.json)
# via `nx setup environment` (written to .env.local). Values below are what the app reads.

# Daikin One integrator API (https://www.daikinone.com/openapi/documentation/index.html). EMAIL is the Daikin account
# the integrator token was issued for.
DAIKIN_API_KEY=
DAIKIN_INTEGRATOR_TOKEN=
EMAIL=
# DAIKIN_BASE_URL=https://integrator-api.daikinskyport.com/v1/

# How often to read the thermostats, record their status and run the automations.
# TICK_INTERVAL_MINUTES=3

UNIVERSE_DB_CONNECTION_STRING=

ANALYTICS_SERVICE_BASE_URL=
ANALYTICS_SERVICE_API_TOKEN=

# Where the built SPA (thermo-automation-web) is served from. Unset in development, where the Vite dev server serves
# it and proxies /api here. The Docker image sets it.
# WEB_ROOT=

# PORT=3009
