# Locally, secrets come from Infisical dev (see secretsPaths in environment-config.json) via
# `nx setup environment`, written to .env.local. Values below are what the app reads.

# Alpaca PAPER keys (they start with PK). The app refuses to start with anything else, and refuses
# any base URL but https://paper-api.alpaca.markets.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
# 300ms between REST calls fits the free plan's 200/minute; a paid plan can go much lower.
# APCA_MIN_INTERVAL_MS=300

UNIVERSE_DB_CONNECTION_STRING=

# Market data. The backtest used SIP bars and NBBO quotes; anything else is a different test.
# sip needs a paid Alpaca data plan for real-time bars; iex is free but thin pre-market.
# STOCK_FEED=sip
# opra needs the OPRA agreement (and a paid plan); indicative is free but not the NBBO.
# OPTIONS_FEED=opra

# Schedule, New York time.
# PREPARE_AT=08:30
# END_AT=20:00
# WARMUP_DAYS=15

# Orders. See src/host/settings.ts for every knob and its default.
# ENTRY_CUSHION=0.02
# ENTRY_TIMEOUT_MS=10000
# EXIT_STEP_MS=3000
# EXIT_MAX_STEPS=4
# SHUTDOWN_FLATTEN_TIMEOUT_MS=60000

# LOG_JSON=false   # readable logs locally
# DEBUG_LOGGING=true   # also log every bar snapshot
# PORT=3013
