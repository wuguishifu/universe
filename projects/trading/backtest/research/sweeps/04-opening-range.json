          "orLow": {
            "minutes": 5
          }
        }
      },
      "or15": {
        "indicators": {
          "orHigh": {
            "minutes": 15
          },
          "orLow": {
            "minutes": 15
          }
        }
      },
      "or30": {
        "indicators": {
          "orHigh": {
            "minutes": 30
          },
          "orLow": {
            "minutes": 30
          }
        }
      }
    },
    "breakouts": {
      "first": {
        "signal": {
          "maxPerSession": 1
        }
      },
      "every": {}
    },
    "stop": {
      "range": {
        "exits": [
          {
            "type": "indicatorBreak",
            "indicator": "orLow",
