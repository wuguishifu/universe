      {
        "type": "flatBeforeClose",
        "minutes": 5
      }
    ],
    "contract": {
      "expiry": {
        "type": "nearest",
        "minDte": 0,
        "maxDte": 0
      },
      "strike": {
        "type": "atm"
      }
    },
    "sizing": {
      "type": "contracts",
      "count": 1
    },
    "risk": [
      {
        "type": "maxPositions",
        "count": 3
      }
