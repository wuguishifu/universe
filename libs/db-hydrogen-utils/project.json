{
  "name": "db-hydrogen-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db-hydrogen-utils/src",
  "projectType": "library",
  "tags": ["scope:server"],
  "targets": {
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "libs/db-hydrogen-utils"
      }
    },
    "migrate:generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "command": "drizzle-kit generate --config=./drizzle.config.ts"
      }
    },
    "migrate:run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "command": "ts-node -r tsconfig-paths/register ./src/lib/migrate.ts"
      }
    },
    "create:db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "command": "ts-node -r tsconfig-paths/register ./src/lib/db/setup.ts"
      }
    },
    "init:db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "parallel": false,
        "commands": [
          "pnpm nx create:db db-hydrogen-utils",
          "pnpm nx migrate:run db-hydrogen-utils"
        ]
      }
    },
    "init:redash": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "command": "./scripts/init-redash.sh"
      }
    },
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "command": "drizzle-kit studio --config=./src/drizzle.config.ts"
      }
    },
    "docker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db-hydrogen-utils",
        "parallel": false,
        "commands": [
          "docker stop db-hydrogen-utils || true",
          "docker compose -f docker-compose.dev.yml up --detach",
          "pnpm nx init:db db-hydrogen-utils",
          "docker ps"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "maxWarnings": 0
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "maxWarnings": 0,
        "fix": true
      }
    },
    "ci:checks": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc", "lint"],
      "options": {
        "command": "echo CI checks done!"
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["ci:checks"],
      "options": {
        "command": "echo Prepush done!"
      }
    }
  }
}
