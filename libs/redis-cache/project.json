{
  "name": "redis-cache",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/redis-cache/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "// targets": "to see all targets run: nx show project redis-cache --web",
  "targets": {
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm madge . --circular --extensions js,ts,tsx --warning --exclude \"(^|/)convex/_generated(/|$)\"",
        "cwd": "libs/redis-cache"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test \"src/**/*.spec.ts\"",
        "cwd": "libs/redis-cache"
      }
    }
  }
}
