{
  "name": "ui-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-web/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "// targets": "to see all targets run: nx show project ui-web --web",
  "targets": {
    "circular-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm madge . --circular --extensions js,ts,tsx --warning",
        "cwd": "libs/ui-web"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build tsconfig.json",
        "cwd": "libs/ui-web"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    },
    "ci:checks": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc", "lint"],
      "options": {
        "command": "echo CI checks done!"
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["ci:checks"],
      "options": {
        "command": "echo Prepush done!"
      }
    }
  }
}
