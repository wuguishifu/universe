{
  "name": "ui-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-web/src",
  "projectType": "library",
  "tags": ["scope:client"],
  "// targets": "to see all targets run: nx show project ui-web --web",
  "targets": {
    "shadcn": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dlx shadcn@latest add {args.component}",
        "cwd": "libs/ui-web"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "libs/ui-web"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "maxWarnings": 0
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "maxWarnings": 0,
        "fix": true
      }
    },
    "ci:checks": {
      "executor": "nx:run-commands",
      "dependsOn": ["tsc", "lint"],
      "options": {
        "command": "echo CI checks done!"
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["ci:checks"],
      "options": {
        "command": "echo Prepush done!"
      }
    }
  }
}
