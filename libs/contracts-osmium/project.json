{
  "name": "contracts-osmium",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contracts-osmium/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "// targets": "to see all targets run: nx show project contracts-osmium --web",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/contracts-osmium/**/*.ts"],
        "maxWarnings": 0
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/contracts-osmium/**/*.ts"],
        "fix": true
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "libs/contracts-osmium"
      }
    },
    "ci:checks": {
      "executor": "nx:run-commands",
      "dependsOn": ["lint", "tsc"],
      "options": {
        "command": "echo CI checks done!"
      }
    },
    "prepush": {
      "executor": "nx:run-commands",
      "dependsOn": ["ci:checks"],
      "options": {
        "command": "echo Prepush Done!"
      }
    }
  }
}
