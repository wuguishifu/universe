{
  "name": "sandbox",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sandbox/src",
  "projectType": "library",
  "tags": ["scope:sandbox"],
  "// targets": "to see all targets run: nx show project sandbox --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/sandbox/src/lib",
        "command": "ts-node -r tsconfig-paths/register generate-sandbox.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/sandbox/src",
        "command": "ts-node -r tsconfig-paths/register sandbox.ts"
      }
    }
  }
}
